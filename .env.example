# MODELO PARA UM BANCO DE DESENVOLVIMENTO PRÓPRIO (NÃO É O BANCO DO EVENTO)
# Copie este arquivo para .env.local e preencha apenas a cópia.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_SEU_POSTGRES_LOCAL
DB_NAME=app_geek_demo
# Alternativa: DATABASE_URL=postgresql://usuario:senha@host:5432/app_geek_demo
# Para bancos que exigem TLS: DB_SSL=true
# DB_CA_CERT_BASE64=BASE64_DE_CERTIFICADO_CA_PUBLICO
DB_POOL_MAX=3

# Endereço de demonstração local (NUNCA aponte para produção neste repositório)
PUBLIC_URL=http://localhost:3000

# Gere dois valores novos e diferentes com o comando no README.
APP_SECRET=GERAR_CHAVE_ALEATORIA_EXCLUSIVA_COM_64_CARACTERES
DEVICE_COOKIE_SECRET=GERAR_OUTRA_CHAVE_ALEATORIA_EXCLUSIVA_64_CARACTERES

# Apenas para criar o admin master na primeira execução. Remova a senha depois.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=SENHA_FORTE_TEMPORARIA_12_OU_MAIS_CARACTERES
